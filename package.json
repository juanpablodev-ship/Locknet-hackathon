{
  "name": "billetera-guardian",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "op": "tsx --env-file=.env",
    "dev:api": "tsx --env-file=.env apps/api/src/main.ts",
    "demo:reset": "tsx demo/reset.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
