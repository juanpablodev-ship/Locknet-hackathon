# Copia este archivo a .env y llena los valores. .env NUNCA se sube al repo.
# Nombres alineados con los snippets oficiales (../open-payments-snippets).

# Wallet de la plataforma (cliente que firma las solicitudes)
WALLET_ADDRESS=
KEY_ID=
PRIVATE_KEY_PATH=

# API
PORT=3000

# Demo: "live" (Test Wallet) o "fixtures" (modo respaldo)
DEMO_MODE=live
