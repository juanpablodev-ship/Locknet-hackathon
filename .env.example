# Copia este archivo a .env y llena los valores. .env NUNCA se sube al repo.
# Nombres alineados con los snippets oficiales (../open-payments-snippets).

# Wallet de la plataforma (cliente que firma las solicitudes).
# Se sacan de la Test Wallet → Developer keys. Guarda la llave como private.key en la raíz
# (el .gitignore ya excluye private* y *.key). Correr scripts con el .env cargado:
#   npm run op -- apps/api/src/members/<script>.ts
WALLET_ADDRESS=
KEY_ID=
PRIVATE_KEY_PATH=private.key

# API
PORT=3000

# Demo: "live" (Test Wallet) o "fixtures" (modo respaldo)
DEMO_MODE=live
