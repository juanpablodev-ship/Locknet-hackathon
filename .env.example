# Copia este archivo a .env y llena los valores. .env NUNCA se sube al repo.
# Nombres alineados con los snippets oficiales (../open-payments-snippets).

# Wallet de la plataforma (cliente que firma las solicitudes).
# Se sacan de la Test Wallet → Developer keys. Guarda la llave como private.key en la raíz
# (el .gitignore ya excluye private* y *.key). Correr scripts con el .env cargado:
#   npm run op -- apps/api/src/members/<script>.ts
WALLET_ADDRESS=
KEY_ID=
PRIVATE_KEY_PATH=private.key

# API (npm run dev:api)
PORT=3000
HOST=127.0.0.1
# URL pública de la API: el banco redirige a PUBLIC_API_URL/api/join/finish
PUBLIC_API_URL=http://localhost:5173
# A dónde vuelve el navegador después de unirse (la web de R4)
WEB_URL=http://localhost:5173
# Cobros: "por-miembro" (plan B, por defecto) o "compartido" (plan A, si se prueba con dos pagadores)
COBROS=por-miembro
# Comisión máxima que acepta checkQuote antes de detener un aporte
MAX_FEE_PERCENT=5

# Demo: "live" (Test Wallet) o "fixtures" (modo respaldo)
DEMO_MODE=live

# Configuración pública del caso familiar. Copia demo/live-config.example.json
# a .env.integration.json. No contiene llaves ni tokens; sí se consume al arrancar.
LIVE_CONFIG_PATH=.env.integration.json
# Diario local ignorado de IDs/estados; nunca guarda tokens.
PAYMENT_JOURNAL_PATH=.env.payment-attempts.json
# Arranque aislado con npm run dev:integration:api y npm run dev:live -w web.
INTEGRATION_API_PORT=3100
# Para otro dispositivo usa un único origen HTTPS que publique Vite y su /api.
INTEGRATION_ORIGIN=http://localhost:5180
INTEGRATION_MODE=live
